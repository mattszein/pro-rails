<nav class="flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400 pb-3">
  <% trail.each_with_index do |crumb, i| %>
    <% unless i.zero? %>
      <span aria-hidden="true" class="text-gray-300 dark:text-gray-600">/</span>
    <% end %>
    <% if last?(i) || crumb.path.nil? %>
      <span class="inline-flex items-center gap-1 font-medium text-gray-700 dark:text-gray-200"
            <%= "aria-current=page".html_safe if last?(i) %>>
        <% if crumb.icon %><%= helpers.icon crumb.icon, {classes: "h-4 w-4"} %><% end %>
        <%= crumb.label %>
      </span>
    <% else %>
      <%= link_to crumb.path,
            class: "inline-flex items-center gap-1 hover:text-primary-600 dark:hover:text-primary-300" do %>
        <% if crumb.icon %><%= helpers.icon crumb.icon, {classes: "h-4 w-4"} %><% end %>
        <%= crumb.label %>
      <% end %>
    <% end %>
  <% end %>
</nav>
