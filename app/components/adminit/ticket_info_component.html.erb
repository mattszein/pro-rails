<div class="flex flex-col">
  <div class="flex items-center gap-4 mb-4">
    <%= helpers.icon "support", {classes: "h-8 dark:text-white"} %>
    <h3><%= t("support.tickets.ticket_number", id: ticket.id) %></h3>
    <%= render(Core::BadgeComponent.new(label: t("enums.ticket.status.#{ticket.status}"), theme: status_theme, icon: "info", size: :md)) %>
    <% if show_ai_state? %>
      <%= render(Core::BadgeComponent.new(label: t("enums.ticket.ai_state.#{ticket.ai_state}"), theme: ai_state_theme, size: :md)) %>
    <% end %>
  </div>
  <%= render Core::BoxComponent.new do %>
    <%= render Core::DefinitionListComponent.new(gap: :sm) do |dl| %>
      <% dl.with_item(term: t("shared.labels.title")) do %>
        <%= ticket.title %>
      <% end %>
      <% dl.with_item(term: t("shared.labels.category")) do %>
        <%= t("enums.ticket.category.#{ticket.category}") %>
      <% end %>
      <% dl.with_item(term: t("shared.labels.created_by")) do %>
        <%= ticket.created.email %>
      <% end %>
      <% dl.with_item(term: t("shared.labels.assigned_to")) do %>
        <%= ticket.assigned&.email || "-" %>
      <% end %>
      <% dl.with_item(term: t("shared.labels.priority")) do %>
        <%= ticket.priority %>
      <% end %>
      <% dl.with_item(term: t("shared.labels.created_on")) do %>
        <%= ticket.created_at.strftime("%Y-%m-%d %H:%M") %>
      <% end %>
      <% dl.with_item(term: t("shared.labels.status")) do %>
        <%= render(Core::BadgeComponent.new(label: t("enums.ticket.status.#{ticket.status}"), theme: status_theme, icon: "info", size: :md)) %>
      <% end %>
      <% if show_ai_state? %>
        <% dl.with_item(term: t("adminit.tickets.ai_state")) do %>
          <%= render(Core::BadgeComponent.new(label: t("enums.ticket.ai_state.#{ticket.ai_state}"), theme: ai_state_theme, size: :md)) %>
        <% end %>
      <% end %>
      <% if playbook_name.present? %>
        <% dl.with_item(term: t("adminit.tickets.ai_playbook")) do %>
          <%= playbook_name %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
