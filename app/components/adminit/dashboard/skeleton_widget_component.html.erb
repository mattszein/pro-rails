<%= render(Core::CardComponent.new(classes: "h-full")) do %>
  <div class="animate-pulse">
    <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/3 mb-4"></div>
    <% if @kind == :analytics %>
      <div class="flex items-center justify-center h-72">
        <div class="w-32 h-32 rounded-full border-8 border-gray-200 dark:border-gray-700 relative">
          <div class="absolute inset-4 rounded-full bg-white dark:bg-gray-800"></div>
        </div>
      </div>
    <% else %>
      <% 4.times do %>
        <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-full mb-2"></div>
      <% end %>
    <% end %>
  </div>
<% end %>
