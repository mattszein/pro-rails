<%= render Adminit::Dashboard::BaseWidgetComponent.new do %>
  <div class="flex flex-col md:flex-row p-2 gap-2">
    <div class="grow basis-1/3 shrink-0">
      <h5 class="pt-1 mb-1 font-semibold"><%= t("adminit.dashboard_widgets.announcements.general.list_title") %></h5>
      <% if announcements.any? %>
        <ul class="space-y-2">
          <% announcements.each do |announcement| %>
            <li class="flex justify-between items-center gap-2 text-sm">
              <%= render(Core::LinkComponent.new(name: announcement.title, url: helpers.adminit_announcement_path(announcement),
                    style: :link, html_options: {class: "truncate", data: {turbo_prefetch: false, turbo_frame: "_top"}})) %>
              <span class="text-xs whitespace-nowrap"><%= l(announcement.scheduled_at, format: :long) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p><%= t("shared.empty") %></p>
      <% end %>
    </div>
    <div class="grow basis-2/3 content-center shrink-0">
      <%= render Adminit::Dashboard::ChartComponent.new(options: chart_options) %>
    </div>
  </div>
<% end %>
