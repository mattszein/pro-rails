<%= render Adminit::Dashboard::BaseWidgetComponent.new(title: title) do %>
  <div class="max-w-md mx-auto">
    <div class="rounded-lg border border-transparent dark:bg-[rgb(28_29_34_/_0.5)] dark:border-white/10 p-2 overflow-hidden">
    <%= tag.div data: {
          controller: "chart",
          chart_options_value: chart_options,
          chart_height_value: chart_height
        } do %>
        <div data-chart-target="canvas"></div>
      <% end %>
    </div>
  </div>
<% end %>
