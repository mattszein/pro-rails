<% one_widget = (widgets.size > 1) %>
<%= render(Core::CardComponent.new(padding: :sm, classes: "h-full overflow-hidden #{container_height_class} flex flex-col #{one_widget ? "inset-shadow-[6px_0_4px_-2px_var(--color-primary-500)]" : "inset-shadow-[6px_0_4px_-2px_var(--color-secondary-500)]"}")) do %>
  <h4><%= I18n.t("adminit.navigation.#{@resource.to_s.pluralize}") %></h4>
  <% if widgets.size > 1 %>
    <%= render Core::TabsComponent.new do |tabs| %>
      <% widgets.each do |widget| %>
        <% tabs.with_tab(name: tab_label(widget)) do %>
          <%= widget_frame(widget) %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="flex-1 overflow-auto min-h-0 h-full">
      <%= widget_frame(widgets.first) %>
    </div>
  <% end %>
<% end %>
