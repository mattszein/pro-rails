<%= render Adminit::Dashboard::BaseWidgetComponent.new do %>
  <div class="flex flex-col md:flex-row p-2 gap-2">
    <div class="grow basis-2/3 shrink-0">
      <%= render Adminit::Dashboard::ChartComponent.new(options: chart_options) %>
    </div>
    <div class="grow basis-1/3 grid grid-cols-2 gap-4 content-center shrink-0">
      <%= render Adminit::Dashboard::BaseAnalyticComponent.new(title: I18n.t("shared.labels.total"), content: stats[:total]) %>
      <%= render Adminit::Dashboard::BaseAnalyticComponent.new(title: I18n.t("enums.ticket.status.open"), content: stats[:open]) %>
      <%= render Adminit::Dashboard::BaseAnalyticComponent.new(title: I18n.t("enums.ticket.status.in_progress"), content: stats[:in_progress]) %>
      <%= render Adminit::Dashboard::BaseAnalyticComponent.new(title: I18n.t("adminit.dashboard_widgets.tickets.analytics.resolved"), content: stats[:resolved]) %>
    </div>
  </div>
<% end %>
