<%= render(Core::LinkComponent.new(url: path, style: :no_style, html_options: link_html_options)) do %>
  <div class="p-4 border-r border-zinc-800 group-hover:border-primary-400 group-hover:text-secondary-400 transition-colors">
    <%= helpers.icon icon_name, {classes: icon_classes} %>
  </div>
  <div class="p-4">
    <span class="text-md uppercase tracking-widest block group-hover:text-primary-400 border-b border-transparent  group-hover:border-secondary-400 transition-all duration-150"><%= label %></span>
  </div>
<% end %>
