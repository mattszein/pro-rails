<%= render Adminit::Dashboard::BaseWidgetComponent.new do %>
  <%= select_tag "account_lookup",
        options_for_select([]),
        class: "w-full py-4",
        "aria-label": t("adminit.dashboard_widgets.accounts.general.placeholder"),
        data: {
          controller: "account-lookup",
          account_lookup_search_url_value: helpers.search_adminit_accounts_path,
          account_lookup_summary_url_value: summary_url,
          placeholder: t("adminit.dashboard_widgets.accounts.general.placeholder")
        } %>
  <%= helpers.turbo_frame_tag "account_summary", class: "block pt-2" %>
<% end %>
