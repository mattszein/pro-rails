<%= render Adminit::Dashboard::BaseWidgetComponent.new do %>
  <% if roles.any? %>
    <%= render Core::TableComponent.new(rows: roles, columns: columns) %>
  <% else %>
    <p class="text-sm text-gray-500 dark:text-gray-400"><%= I18n.t("adminit.dashboard_widgets.roles.no_roles") %></p>
  <% end %>
<% end %>
