<div class="flex gap-3" id="<%= dom_id(message) %>">
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1 flex-wrap">
      <span class="font-medium text-slate-800 dark:text-slate-200"><%= author_display_name %></span>
      <%= author_badge %>
      <span class="text-sm text-slate-500 dark:text-slate-400"><%= helpers.local_time_ago(message.created_at) %></span>
      <% unless message.ai? %>
        <!-- Edit action -->
        <turbo-show when="current-user-id" is="<%= message.account_id %>">
          <div class="ml-auto flex gap-2">
          </div>
        </turbo-show>
      <% end %>
    </div>
    <div class="<%= message_background %> rounded-2xl rounded-tl-md p-3">
      <%= simple_format(message.content, class: "whitespace-pre-wrap break-words") %>
    </div>
    <% if show_articles? %>
      <div class="mt-2 space-y-2" data-role="articles">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= t("support.message.articles_heading") %></p>
        <% articles.each do |article| %>
          <%= render Core::CardComponent.new(padding: :xs, classes: "space-y-1") do %>
            <%= render Core::LinkComponent.new(name: article.title, url: helpers.help_article_path(slug: article.slug, locale: article.locale), style: :link, html_options: {target: "_blank", rel: "noopener", class: "font-medium"}) %>
            <p class="text-sm text-slate-600 dark:text-slate-400"><%= article.summary %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% if show_resolution_actions? %>
      <turbo-show when="current-user-id" is="<%= resolution_ticket.created_id %>">
        <div class="mt-2 flex flex-wrap gap-2" data-resolution-actions>
          <%= render Core::LinkComponent.new(name: t("support.message.solved"), url: helpers.resolve_with_ai_support_ticket_path(resolution_ticket.id), style: :as_button, theme: :create, size: :sm, html_options: {data: {turbo_method: :post}}) %>
          <%= render Core::LinkComponent.new(name: t("support.message.not_solved"), url: helpers.request_human_support_ticket_path(resolution_ticket.id), style: :as_button, theme: :secondary, size: :sm, html_options: {data: {turbo_method: :post}}) %>
        </div>
      </turbo-show>
    <% end %>
  </div>
</div>
