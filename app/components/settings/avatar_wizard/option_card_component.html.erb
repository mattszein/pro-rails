<div class="flex flex-col gap-1 p-3 rounded-xl border-2 cursor-pointer transition-all
            border-gray-200 dark:border-gray-700 hover:border-primary-300
            has-[:checked]:border-primary-500 has-[:checked]:bg-primary-50 dark:has-[:checked]:bg-primary-900/20"
     data-option-group-target="card">
  <%= radio_button_tag name, value, selected,
        id: input_id,
        class: "sr-only",
        data: {action: "change->option-group#refresh"} %>
  <label for="<%= input_id %>" class="cursor-pointer select-none flex flex-col gap-1">
    <% if colors.any? %>
      <div class="flex gap-1 mb-1">
        <% colors.each do |color| %>
          <div class="w-5 h-5 rounded-full border border-white/20 shadow-sm"
               style="background-color: <%= color %>"></div>
        <% end %>
      </div>
    <% end %>
    <span><%= label %></span>
    <% if description %>
      <span><%= description %></span>
    <% end %>
  </label>
</div>
