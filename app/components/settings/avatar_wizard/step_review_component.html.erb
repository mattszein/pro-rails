<div class="space-y-6">
  <h2 class="text-xl font-semibold"><%= t("avatars.wizard.review_title") %></h2>
  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t("avatars.wizard.review_subtitle") %></p>

  <% if avatar.generated? && dna_summary_rows.any? %>
    <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-4 space-y-2">
      <%= render collection: dna_summary_rows, partial: "settings/avatars/dna_row", as: :row %>
    </div>
  <% end %>

  <%= form_with url: generate_settings_avatar_path(avatar),
      method: :post,
      builder: CustomFormBuilder,
      data: { turbo_confirm: t("avatars.wizard.forge_confirm") } do |f| %>

    <%= render Core::AiModelSelectorComponent.new(
      kind: :image,
      current_model: avatar.image_model.presence || AvatarAiConfig.default_image_model,
      field_name: :image_model
    ) %>

    <div class="flex gap-3 mt-4">
      <%= render(Core::LinkComponent.new(
        name: t("avatars.wizard.back_to_edit"),
        url: settings_avatar_path(avatar, step: review_back_step),
        style: :as_button,
        theme: :secondary,
        html_options: { data: { turbo_frame: "avatar_wizard_step" } }
      )) %>
      <%= f.button t("avatars.wizard.forge_avatar"), {theme: :create, type: :submit} %>
    </div>
  <% end %>
</div>
