<div class="grid grid-cols-3 gap-3" data-controller="mood-board">
  <% prompts.each_with_index do |prompt, index| %>
    <label class="relative aspect-square rounded-xl border-2 overflow-hidden cursor-pointer transition-all
                  <%= selected_indices.include?(index) ? "border-primary-500" : "border-gray-200 dark:border-gray-700 hover:border-primary-300" %>">
      <%= check_box_tag "avatar[dna][mood_board_selected][]", index,
          selected_indices.include?(index),
          class: "sr-only peer",
          data: { mood_board_target: "checkbox" } %>

      <div class="w-full h-full bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-700 flex items-center justify-center p-2">
        <p class="text-xs text-gray-500 dark:text-gray-400 text-center leading-tight line-clamp-3">
          <%= prompt %>
        </p>
      </div>

      <div class="absolute inset-0 bg-primary-500/20 opacity-0 peer-checked:opacity-100 transition-opacity flex items-center justify-center">
        <div class="w-8 h-8 rounded-full bg-primary-500 text-white flex items-center justify-center text-sm font-bold">
          ✓
        </div>
      </div>

      <span class="absolute top-1 left-1 text-xs bg-black/50 text-white px-1.5 py-0.5 rounded-full">
        <%= index + 1 %>
      </span>
    </label>
  <% end %>
</div>

<p class="text-xs mt-2 text-center">
  <%= t("avatars.freeform.step2.select_hint") %>
</p>
