<div class="flex flex-col h-full" data-controller="tabs"
     data-tabs-active-classes-value="<%= active_classes %>"
     data-tabs-inactive-classes-value="<%= inactive_classes %>">
  <div class="flex border-b border-primary-300" role="tablist">
    <% tabs.each_with_index do |tab, i| %>
      <button type="button" role="tab"
              data-tabs-target="tab"
              data-action="click->tabs#select"
              data-index="<%= i %>"
              aria-selected="<%= i.zero? %>"
              class="<%= tab_classes(i.zero?) %> group/tab">
        <%= tab.name %>
        <span class="<%= Core::SubmenuStyles::UNDERLINE_BASE %> opacity-0 group-aria-selected/tab:opacity-100"></span>
      </button>
    <% end %>
  </div>
  <div class="flex-1 overflow-auto min-h-0">
    <% tabs.each_with_index do |tab, i| %>
      <div data-tabs-target="panel" data-index="<%= i %>" role="tabpanel"
           class="<%= "hidden" unless i.zero? %> h-full">
        <%= tab %>
      </div>
    <% end %>
  </div>
</div>
