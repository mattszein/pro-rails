<% if editable %>
  <div class="relative inline-block cursor-pointer group" data-action="click->click-forwarder#forward">
    <% if profile.avatar.attached? %>
      <%= image_tag profile.avatar.variant(avatar_variant), alt: profile.username.to_s, class: "#{size_class} rounded-full object-cover #{hover_ring_classes}" %>
    <% else %>
      <div class="<%= size_class %> rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center font-bold text-gray-500 dark:text-gray-300 <%= hover_ring_classes %>">
        <%= fallback_initial %>
      </div>
    <% end %>
    <div class="absolute inset-0 flex items-center justify-center rounded-full bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity">
      <%= helpers.icon("camera", classes: "w-7 h-7 text-white") %>
    </div>
  </div>
<% else %>
  <% if profile.avatar.attached? %>
    <%= image_tag profile.avatar.variant(avatar_variant), alt: profile.username.to_s, class: "#{size_class} rounded-full object-cover" %>
  <% else %>
    <div class="<%= size_class %> rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center font-bold text-gray-500 dark:text-gray-300">
      <%= fallback_initial %>
    </div>
  <% end %>
<% end %>
