<div class="flex border-b border-primary-300 mb-8" role="group">
  <% @sections.each do |section| %>
    <%= link_to section.path, class: link_classes(section),
          "aria-current": (active?(section) ? "page" : nil) do %>
      <%= section.name %>
      <% if active?(section) %>
        <span class="<%= Core::SubmenuStyles::UNDERLINE_BASE %>"></span>
      <% end %>
    <% end %>
  <% end %>
</div>
