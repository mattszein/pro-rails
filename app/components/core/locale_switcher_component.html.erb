<div class="flex items-center" data-controller="core--locale-switcher-component">
  <select aria-label="<%= t("shared.common.select_language") %>" data-action="change->core--locale-switcher-component#change" class="rounded-md border-0 bg-transparent text-sm font-medium text-gray-600 hover:text-gray-900 dark:bg-transparent dark:text-gray-300 dark:hover:text-white cursor-pointer py-1 pl-2 pr-7 focus:ring-primary-500 focus:border-primary-500">
    <% locales.each do |loc| %>
      <option value="<%= loc %>" <%= "selected" if current_locale == loc %>><%= loc.to_s.upcase %></option>
      <% end %>
    </select>
  </div>
