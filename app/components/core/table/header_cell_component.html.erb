<th class="py-2 px-4 text-left font-bold text-gray-500 dark:text-gray-200 uppercase whitespace-nowrap">
  <% if sortable? %>
    <%= link_to sort_url,
          class: "inline-flex items-center gap-1 hover:text-gray-700 dark:hover:text-gray-100 #{"text-primary-600 dark:text-primary-400" if active?}" do %>
      <%= column.label %>
      <% if active? %>
        <span class="text-xs font-normal"><%= sort_indicator %></span>
      <% else %>
        <span class="text-xs font-normal text-gray-400">↕</span>
      <% end %>
    <% end %>
  <% else %>
    <%= column.label %>
  <% end %>
</th>
