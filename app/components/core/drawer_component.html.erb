<aside id="drawer" class="fixed top-0 left-0 h-screen w-0 bg-highlight dark:bg-highlight border-r border-zinc-200 dark:border-secondary-900 hover:w-80 data-open:w-80 transition-all duration-300 group/drawer z-100" aria-labelledby="drawer-label" aria-modal="true" role="dialog" data-controller="core--drawer-component" data-action="click@window->core--drawer-component#closeOnOutsideClick keydown.esc@window->core--drawer-component#close">
  <header class="flex h-16 items-center">
    <button type="button" class="flex items-center shrink-0 p-4 gap-4 backdrop-blur-md rounded-md cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-300" aria-controls="drawer" aria-expanded="false" data-core--drawer-component-target="toggle" data-action="core--drawer-component#toggle">
      <%= render Core::LogoComponent.new %>
    </button>
  </header>
  <%= content %>
</aside>
