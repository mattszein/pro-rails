<div class="<%= card_classes %>"
     data-controller="animated-icon"
     data-animated-icon-type-value="<%= animated_type %>"
     data-action="mouseenter->animated-icon#start mouseleave->animated-icon#stop">
  <div class="flex items-center mb-4 space-x-4">
    <div class="<%= icon_wrapper_classes %>">
      <%= helpers.icon(icon, classes: "w-7 h-7") %>
    </div>
    <h3 class="<%= title_classes %>">
      <%= t("landing.features.#{i18n_key}.title") %>
    </h3>
  </div>
  <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
    <%= t("landing.features.#{i18n_key}.description") %>
  </p>
</div>
