<div id="<%= dom_id(ticket, "message_form") %>">
  <% if ticket.messageable? %>
    <%= form_with model: Support::Message.new, url: support_ticket_messages_path(ticket), id: "message_form", class: "flex gap-3", data: {controller: "message-form", action: "turbo:submit-start->message-form#beforeSubmit turbo:submit-end->message-form#afterSubmit"} do |form| %>
      <%= form.text_area :content,
            rows: 1,
            placeholder: t("support.messages.placeholder"),
            class: "flex-1 px-4 py-3 rounded-xl resize-none",
            data: {
              message_form_target: "textarea",
              action: "keydown->message-form#handleKeydown"
            } %>
      <%= form.button t("shared.buttons.send"), {theme: :primary}, data: {message_form_target: "submit"} %>
    <% end %>
  <% else %>
    <%# Rendered in broadcasts too (no current_account there): on a finished ticket the requester sees the
        reopen form and everyone else the status banner, both gated client-side with <turbo-show>. %>
    <% if ticket.finished? %>
      <turbo-show when="current-user-id" is="<%= ticket.created_id %>">
        <%= render Support::ReopenFormComponent.new(ticket: ticket) %>
      </turbo-show>
    <% end %>
    <% if ticket.finished? %>
      <turbo-show when="current-user-id" is_not="<%= ticket.created_id %>">
        <%= render Support::TicketStatusBannerComponent.new(ticket: ticket) %>
      </turbo-show>
    <% else %>
      <%= render Support::TicketStatusBannerComponent.new(ticket: ticket) %>
    <% end %>
  <% end %>
</div>
