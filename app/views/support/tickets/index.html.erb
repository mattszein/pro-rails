<div class="w-full space-y-2">
  <%= render Core::CardComponent.new(padding: :sm) do %>
    <div class="flex justify-between items-center">
      <h1 class="text-xl font-semibold"><%= t("support.tickets.title") %></h1>
      <%= render(Core::LinkComponent.new(name: t("support.tickets.add_ticket"), url: new_support_ticket_path, style: :as_button, theme: :create, size: :sm, html_options: {data: {turbo_frame: "modal"}})) %>
    </div>
  <% end %>
  <%= turbo_stream_from "tickets" %>
  <%= render Core::CardComponent.new(padding: :none) do %>
    <div class="w-full overflow-x-auto p-4">
      <%= render Core::TableComponent.new(
            rows: @tickets,
            columns: [
              {label: t("shared.labels.title"), sort_key: :title, filter: {type: :text, param: :search}},
              {label: t("shared.labels.category"), filter: {type: :select, param: :category, options: -> { Support::Ticket.categories.keys.map { |c| [I18n.t("enums.ticket.category.#{c}"), c] } }}},
              {label: t("shared.labels.description")},
              {label: t("shared.labels.status"), sort_key: :status, filter: {type: :select, param: :status, options: -> { Support::Ticket.statuses.keys.map { |s| [I18n.t("enums.ticket.status.#{s}"), s] } }}},
              {label: t("shared.common.actions")}
            ],
            options: {
              ids: {tbody: "tickets"},
              frame_id: "support_tickets_table",
              pagy: @pagy,
              sortable: true,
              filterable: true
            }
          ) do %>
        <% @tickets.each_with_index do |ticket, index| %>
          <%= render "ticket_table", ticket: ticket, index: index %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
