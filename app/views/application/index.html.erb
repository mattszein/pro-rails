<% content_for(:landing) { true } %>
<% content_for(:title) { t("landing.page_title") } %>
<% content_for :head do %>
  <style>
    @keyframes gradient-x {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    .animate-gradient-x {
      background-size: 200% auto;
      animation: gradient-x 4s ease infinite;
    }
  </style>
<% end %>
<div class="bg-[#f8f9fa] dark:bg-[#0f0f11] text-slate-900 dark:text-slate-200 transition-colors duration-300 selection:bg-[#c25044]/20 selection:text-[#c25044] dark:selection:text-[#e2a8a0]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 space-y-24 md:space-y-32">
    <%# ── Hero ─────────────────────────────────────────────────────────── %>
    <section class="relative text-center max-w-3xl mx-auto flex flex-col items-center justify-center">
      <svg class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[150%] max-w-2xl opacity-20 dark:opacity-10 pointer-events-none"
           viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <circle cx="100" cy="100" r="40" fill="none" stroke="currentColor" stroke-width="2" class="text-[#c25044] dark:text-[#e2a8a0]">
          <animate attributeName="r" values="40;90;40" dur="6s" repeatCount="indefinite" />
          <animate attributeName="opacity" values="1;0;1" dur="6s" repeatCount="indefinite" />
        </circle>
        <circle cx="100" cy="100" r="60" fill="none" stroke="currentColor" stroke-width="1" class="text-[#5a2323] dark:text-[#ffc4bc]">
          <animate attributeName="r" values="60;120;60" dur="8s" repeatCount="indefinite" />
          <animate attributeName="opacity" values="0.8;0;0.8" dur="8s" repeatCount="indefinite" />
        </circle>
      </svg>
      <div class="inline-block relative z-10 p-8 md:p-12 w-full rounded-2xl bg-white/90 dark:bg-[#1a1a1c]/90 backdrop-blur-md border border-slate-200 dark:border-[#222225] shadow-sm dark:shadow-none mb-8 transition-colors duration-300">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 pb-2 text-transparent bg-clip-text bg-gradient-to-r from-[#8a3333] via-[#e25d4f] to-[#5a2323] dark:from-[#ffc4bc] dark:via-[#e2a8a0] dark:to-[#a86860] animate-gradient-x">
          <%= t("landing.hero.title") %>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
          <%= t("landing.hero.subtitle") %>
        </p>
      </div>
    </section>
    <%# ── Feature cards ────────────────────────────────────────────────── %>
    <%
      features = [
        {icon: "lock", color: "blue", i18n_key: "authentication", animated_type: "lock"},
        {icon: "shield", color: "emerald", i18n_key: "authorization", animated_type: "shield"},
        {icon: "connect", color: "violet", i18n_key: "real_time", animated_type: "connect"},
        {icon: "charts", color: "rose", i18n_key: "admin_panel", animated_type: "charts"},
        {icon: "layers", color: "amber", i18n_key: "ui_components", animated_type: "layers"},
        {icon: "chat", color: "cyan", i18n_key: "support_tickets", animated_type: "chat"},
        {icon: "sliders", color: "orange", i18n_key: "profile_settings", animated_type: "sliders"},
        {icon: "contrast", color: "fuchsia", i18n_key: "theme_support", animated_type: "contrast"}
      ]
    %>
    <section>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% features.each do |feature| %>
          <%= render "shared/landing/feature_card", feature: feature %>
        <% end %>
      </div>
    </section>
    <%# ── Architecture & DX ────────────────────────────────────────────── %>
    <section class="border-t border-slate-200 dark:border-[#222225] pt-16">
      <h2 class="text-2xl font-semibold mb-12 text-slate-900 dark:text-slate-100 text-center">
        <%= t("landing.architecture.title") %>
      </h2>
      <div class="space-y-12">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-6 px-2">
            <%= t("landing.architecture.quality.heading") %>
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <%= render "shared/landing/sticky_note_card",
                  icon_name: "network",
                  title: t("landing.architecture.quality.interactors.title"),
                  description: t("landing.architecture.quality.interactors.description") %>
            <%= render "shared/landing/sticky_note_card",
                  icon_name: "flask",
                  title: t("landing.architecture.quality.testing.title"),
                  description: t("landing.architecture.quality.testing.description") %>
            <%= render "shared/landing/sticky_note_card",
                  icon_name: "code",
                  title: t("landing.architecture.quality.code_quality.title"),
                  description: t("landing.architecture.quality.code_quality.description") %>
          </div>
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-6 px-2">
            <%= t("landing.architecture.infrastructure.heading") %>
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <%= render "shared/landing/sticky_note_card",
                  icon_name: "database",
                  title: t("landing.architecture.infrastructure.jobs.title"),
                  description: t("landing.architecture.infrastructure.jobs.description") %>
            <%= render "shared/landing/sticky_note_card",
                  icon_name: "globe",
                  title: t("landing.architecture.infrastructure.i18n.title"),
                  description: t("landing.architecture.infrastructure.i18n.description") %>
            <%= render "shared/landing/sticky_note_card",
                  icon_name: "bell",
                  title: t("landing.architecture.infrastructure.notifications.title"),
                  description: t("landing.architecture.infrastructure.notifications.description") %>
            <%= render "shared/landing/sticky_note_card",
                  icon_name: "zap",
                  title: t("landing.architecture.infrastructure.assets.title"),
                  description: t("landing.architecture.infrastructure.assets.description") %>
          </div>
          <div class="grid grid-cols-1 mt-4">
            <%= render "shared/landing/sticky_note_card",
                  icon_name: "wrench",
                  title: t("landing.architecture.infrastructure.config.title"),
                  description: t("landing.architecture.infrastructure.config.description") %>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="py-8 text-center text-sm text-slate-500 dark:text-slate-600 border-t border-slate-200 dark:border-[#222225] mt-24">
    <p>&copy; <%= Date.current.year %> <%= t("landing.footer.text") %></p>
  </footer>
</div>
