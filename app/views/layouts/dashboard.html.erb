<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("shared.layout.app_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy" %>
    <%= javascript_importmap_tags %>
    <%= action_cable_with_jwt_meta_tag(current_user: current_account) if current_account %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Google+Sans+Code:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Jost:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Manrope:wght@400;500;600;700&family=Orbitron:wght@400;500;600;700;900&family=Outfit:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <% if current_account %>
      <meta name="current-user-id" content="<%= current_account.id %>">
    <% end %>
  </head>
  <body class="antialiased bg-default min-h-screen" data-controller="closer">
    <%= render "shared/auth_navbar" %>
    <div class="md:flex w-full min-h-screen z-30">
    <%= render(Core::SidebarComponent.new(open: false, title: t("shared.layout.app_menu"))) do %>
      <%= render "partials/navigation" %>
    <% end %>
    <main class="grow pt-16 px-8 overflow-x-scroll" role="main">
      <%= turbo_frame_tag "modal", target: "_top" %>
      <%= yield %>
    </main>
    <%= render "shared/flashes" %>
    </div>
  </body>
</html>
