<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="ROBOTS" content="NOODP">
    <meta name="view-transition" content="same-origin">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <title>
      <%= t("adminit.layout.title_prefix") %> <%= Rails.application.class %>
    </title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy" %>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.6.2/dist/css/tom-select.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/air-datepicker@3.6.0/air-datepicker.min.css">
    <%= action_cable_with_jwt_meta_tag(current_user: current_account) if current_account %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;600;700&family=Space+Grotesk:wght@400;600;700&family=Outfit:wght@400;600;700&family=Bricolage+Grotesque:wght@400;600;700&family=Google+Sans+Code:wght@400;600;700&family=Orbitron:wght@400;600;700;900&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">

    <% if current_account %>
      <meta name="current-user-id" content="<%= current_account.id %>">
    <% end %>

  </head>
  <body class="min-h-screen bg-indigo-50 dark:bg-black">
    <%= render "shared/auth_navbar" %>
    <div class="md:flex w-full min-h-screen z-30">
      <%= render(Core::SidebarComponent.new(open: false, title: t("shared.layout.app_menu"))) do %>
        <%= render "navigation" %>
      <% end %>
      <main class="grow pt-16 px-8 overflow-x-scroll" role="main">
        <%= turbo_frame_tag "modal", target: "_top" %>
        <%= render Adminit::BreadcrumbComponent.new(trail: adminit_breadcrumb_trail) %>
        <%= yield %>
      </main>
      <%= render "shared/flashes" %>
    </div>
  </body>
</html>
