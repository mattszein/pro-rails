<%= render(Core::CardComponent.new) do %>
  <%= form_with url: rodauth.create_account_path, method: :post, data: {turbo: false}, class: form_classes do |form| %>
    <%= form.label :email, t("rodauth.labels.email") %>
    <%= form.text_field :email, {required: true, autofocus: true, placeholder: t("rodauth.placeholders.email"), value: params[rodauth.login_param], aria: ({invalid: true, describedby: "login_error_message"} if rodauth.field_error(rodauth.login_param))} %>
    <%= error_tag(rodauth.field_error(rodauth.login_param), id: "login_error_message") if rodauth.field_error(rodauth.login_param) %>
    <%= form.label :password, t("rodauth.labels.password") %>
    <%= form.password_field :password, {required: true, placeholder: t("rodauth.placeholders.password")} %>
    <%= error_tag(rodauth.field_error(rodauth.password_param), id: "password_error_message") if rodauth.field_error(rodauth.password_param) %>
    <%= form.label "password-confirm", t("rodauth.labels.password_confirm") %>
    <%= form.password_field "password-confirm", {required: true, placeholder: t("rodauth.placeholders.password_confirm")} %>
    <div class="mt-6">
      <%= form.button t("rodauth.register"), {fullw: true} %>
    </div>
  <% end %>
<% end %>
