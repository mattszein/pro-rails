<div class="w-full">
  <div class="flex justify-between items-center pb-2">
    <h1 class="text-xl font-semibold"><%= t("adminit.navigation.announcements") %></h1>
    <%= render(Core::LinkComponent.new(name: t("adminit.announcements.new_announcement"), url: new_adminit_announcement_path, style: :as_button, theme: :create, size: :sm, html_options: {data: {turbo_frame: "modal"}})) %>
  </div>
  <%= render Core::CardComponent.new do %>
    <%= render Core::TableComponent.new(
          rows: @announcements,
          columns: @columns,
          options: {
            ids: {tbody: "admin_announcements", col_prefix: "admin"},
            frame_id: "admin_announcements_table",
            pagy: @pagy,
            sortable: true,
            filterable: true
          }
        ) %>
  <% end %>
</div>
