<div class="w-full">
  <div class="flex justify-between items-center pb-2">
    <h1 class="text-xl font-semibold"><%= t("adminit.navigation.ai_playbooks") %></h1>
    <%= render(Core::LinkComponent.new(name: t("adminit.ai_playbooks.new"), url: new_adminit_ai_playbook_path, style: :as_button, theme: :create, size: :sm, html_options: {data: {turbo_frame: "modal"}})) %>
  </div>
  <%= render Core::CardComponent.new do %>
    <%= render Core::TableComponent.new(
          rows: @playbooks,
          columns: ai_playbook_columns,
          options: {ids: {tbody: "admin_ai_playbooks", col_prefix: "admin"}}
        ) %>
  <% end %>
</div>
