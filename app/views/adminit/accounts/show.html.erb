<div class="w-full">
  <div class="flex justify-between items-center pb-2">
    <%= render(Core::LinkComponent.new(name: t("adminit.accounts.back_to_accounts"), url: adminit_accounts_path, style: :link)) %>
  </div>

  <div class="space-y-4">
    <div class="flex gap-4">
    <%= render(Core::CardComponent.new(classes: "basis-1/2 space-y-4")) do %>
      <h2><%= t("adminit.accounts.account") %></h2>
      <%= render Core::BoxComponent.new do %>
        <%= render Core::DefinitionListComponent.new(gap: :sm) do |dl| %>
          <% dl.with_item(term: t("shared.labels.id")) do %>
            <%= @account.id %>
          <% end %>
          <% dl.with_item(term: t("shared.labels.email")) do %>
            <%= @account.email %>
          <% end %>
          <% dl.with_item(term: t("shared.labels.role")) do %>
            <%= @account.role&.name || "-" %>
          <% end %>
          <% dl.with_item(term: t("shared.labels.status")) do %>
            <%= render(Core::BadgeComponent.new(label: t("enums.account.status.#{@account.status}"), theme: account_status_theme(@account.status))) %>
          <% end %>
          <% dl.with_item(term: t("shared.labels.created_on")) do %>
            <%= l(@account.created_at.to_date, format: :long) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= render(Core::CardComponent.new(classes: "basis-1/2 space-y-4")) do %>
        <h2><%= t("adminit.accounts.profile") %></h2>
        <% if (profile = @account.profile) %>
          <div class="flex items-center gap-4">
            <%= render Core::AvatarComponent.new(profile: profile, size: :lg) %>
            <%= render Core::DefinitionListComponent.new(gap: :sm) do |dl| %>
              <% dl.with_item(term: t("shared.labels.username")) do %>
                <%= profile.username.presence || "-" %>
              <% end %>
              <% dl.with_item(term: t("shared.labels.bio")) do %>
                <%= profile.bio.presence || "-" %>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p><%= t("adminit.accounts.no_profile") %></p>
        <% end %>
      <% end %>
    </div>
    <%= render(Core::CardComponent.new(classes: "space-y-4")) do %>
      <h2 class="font-semibold"><%= t("adminit.accounts.activity") %></h2>
      <%= render Core::BoxComponent.new() do %>
        <%= render Core::DefinitionListComponent.new(gap: :sm) do |dl| %>
          <% dl.with_item(term: t("shared.labels.tickets_created")) do %>
            <%= @tickets_created_count %>
          <% end %>
          <% dl.with_item(term: t("shared.labels.tickets_assigned")) do %>
            <%= @tickets_assigned_count %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render(Core::CardComponent.new(classes: "space-y-4")) do %>
      <h2><%= t("adminit.accounts.session") %></h2>
      <% if @remember_key %>
        <%= render Core::BoxComponent.new(variant: :success) do %>
          <p><%= t("adminit.accounts.session_expires", date: l(@remember_key.deadline, format: :long)) %></p>
        <% end %>
      <% else %>
        <%= render Core::BoxComponent.new(variant: :neutral) do %>
          <p><%= t("adminit.accounts.no_session") %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
