<%= render(Core::ModalComponent.new(title: t("adminit.feature_flags.add_account"))) do %>
  <%= form_with(url: add_account_adminit_feature_flag_path(@feature_flag), method: :post) do |f| %>
    <div class="space-y-4">
      <%= select_tag "account_id", options_for_select([]), required: true, data: {
            controller: "role-account-search",
            role_account_search_url_value: search_adminit_accounts_path,
            placeholder: t("shared.labels.email")
          } %>
      <%= f.select :access, FeatureFlagAccount.accesses.keys.map { |access| [t("enums.feature_flag_account.access.#{access}"), access] }, selected: "allowed" %>
      <%= f.button t("adminit.feature_flags.add_account_entry"), {theme: :create, fullw: true} %>
    </div>
  <% end %>
<% end %>
