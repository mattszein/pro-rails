<div class="w-full">
  <div class="flex justify-between items-center pb-2">
    <h1 class="text-xl font-semibold"><%= t("adminit.navigation.tickets") %></h1>
  </div>
  <%= turbo_stream_from "admin_tickets" %>
  <%= render Core::CardComponent.new(padding: :md) do %>
    <%= render Core::TableComponent.new(
          rows: @tickets,
          columns: @columns,
          options: {
            ids: {tbody: "admin_tickets", col_prefix: "admin"},
            frame_id: "admin_tickets_table",
            pagy: @pagy,
            sortable: true,
            filterable: true
          }
        ) %>
  <% end %>
</div>
