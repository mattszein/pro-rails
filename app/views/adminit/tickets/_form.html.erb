<%= form_with(model: ticket, url: ticket.persisted? ? adminit_ticket_path(ticket) : adminit_tickets_path, data: {turbo: true}) do |form| %>
  <%= render "adminit/application/form_errors", record: ticket %>
    <%= form.label :title, t("shared.labels.title") %>
    <%= form.text_field :title, {autofocus: true, required: true, placeholder: t("shared.placeholders.title"), autocomplete: "title", class: "w-full"} %>
    <div class="mt-6">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 4, placeholder: t("support.tickets.description_placeholder"), class: "w-full mt-4" %>
    </div>
    <div class="mt-6">
    <%= form.label :priority, class: "mr-2" %>
    <%= form.counter :priority, {value: ticket&.priority || 5, min: 1, max: 5} %>
    </div>
  <div class="mt-6">
    <%= form.button t("shared.common.save"), {theme: :create, fullw: true} %>
  </div>
<% end %>
