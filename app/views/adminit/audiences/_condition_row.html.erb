<% condition = audience_condition.condition %>
<% return unless condition %>
<div class="border rounded-md p-3 space-y-2" data-controller="conditional-field">
  <%= f.hidden_field :condition_key %>
  <%= f.hidden_field :id if audience_condition.persisted? %>
  <label class="flex items-center gap-2 cursor-pointer">
    <%= check_box_tag "audience[audience_conditions_attributes][#{f.index}][enabled]", "1", audience_condition.persisted?,
          data: {conditional_field_target: "toggle", action: "change->conditional-field#sync"} %>
    <span class="font-medium"><%= t("audience_conditions.#{condition.key}.label") %></span>
  </label>
  <p class="text-sm text-slate-500 dark:text-slate-400"><%= t("audience_conditions.#{condition.key}.hint") %></p>
  <div data-conditional-field-target="field" <%= "hidden" unless audience_condition.persisted? %>>
    <%= render "adminit/audiences/conditions/#{condition.type}", f: f, condition: condition, audience_condition: audience_condition %>
  </div>
</div>
