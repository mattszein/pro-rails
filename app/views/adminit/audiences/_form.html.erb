<%= form_with(model: audience, url: audience.persisted? ? adminit_audience_path(audience) : adminit_audiences_path,
      data: {turbo: true}, html: {class: "space-y-4"}) do |form| %>
  <% if audience.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2><%= pluralize(audience.errors.count, "error") %> prohibited this audience from being saved:</h2>
      <ul>
        <% audience.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.label :name, t("shared.labels.name") %>
  <%= form.text_field :name, {autofocus: true, required: true, class: "w-full"} %>

  <%= form.label :description, t("shared.labels.description") %>
  <%= form.text_area :description, {class: "w-full"} %>

  <div>
    <h3 class="font-semibold mb-2"><%= t("adminit.audiences.conditions") %></h3>
    <div class="space-y-3">
      <%= form.fields_for :audience_conditions do |cf| %>
        <%= render "adminit/audiences/condition_row", f: cf, audience_condition: cf.object %>
      <% end %>
    </div>
  </div>

  <div class="mt-6">
    <%= form.button t("shared.common.save"), {theme: :create, fullw: true} %>
  </div>
<% end %>
