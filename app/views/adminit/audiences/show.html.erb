<div class="w-full">
  <div class="flex justify-between items-center pb-2">
    <%= render(Core::LinkComponent.new(name: t("adminit.audiences.back_to_audiences"), url: adminit_audiences_path, style: :link)) %>
    <div class="flex gap-2 items-center px-4">
      <%= render(Core::LinkComponent.new(name: t("shared.common.edit"), url: edit_adminit_audience_path(@audience), style: :as_button, theme: :edit, size: :sm)) %>
      <% if @audience.archived? %>
        <%= render(Core::LinkComponent.new(name: t("adminit.audiences.unarchive"), url: unarchive_adminit_audience_path(@audience), style: :as_button, theme: :edit, size: :sm, html_options: {data: {turbo_method: :patch}})) %>
      <% else %>
        <%= render(Core::LinkComponent.new(name: t("adminit.audiences.archive"), url: archive_adminit_audience_path(@audience), style: :as_button, theme: :delete, size: :sm, html_options: {data: {turbo_method: :patch, turbo_confirm: t("shared.common.are_you_sure")}})) %>
      <% end %>
    </div>
  </div>

  <%= render Core::CardComponent.new(classes: "space-y-4") do %>
    <div class="flex items-center gap-4">
      <h1 class="text-xl font-bold"><%= @audience.name %></h1>
      <%= render(Core::BadgeComponent.new(
            label: t("adminit.audiences.states.#{@audience.archived? ? :archived : :active}"),
            theme: @audience.archived? ? :secondary : :green
          )) %>
    </div>
    <% if @audience.description.present? %>
      <p class="text-slate-500"><%= @audience.description %></p>
    <% end %>

    <%= render Core::BoxComponent.new do %>
      <%= render Core::DefinitionListComponent.new(gap: :sm) do |dl| %>
        <% dl.with_item(term: t("adminit.audiences.conditions")) do %>
          <% if @audience.audience_conditions.any? %>
            <%= audience_condition_summary(@audience) %>
          <% else %>
            <%= t("adminit.audiences.no_conditions") %>
          <% end %>
        <% end %>
        <% dl.with_item(term: t("adminit.audiences.flags_attached")) do %>
          <%= @audience.feature_flags.size %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
