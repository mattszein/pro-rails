<tr id="<%= ActionView::RecordIdentifier.dom_id(permission) %>">
  <%= render Core::TableCellComponent.new do %>
    <%= permission.resource.titleize %>
  <% end %>
  <%= render Core::TableCellComponent.new do %>
    <%= form_with(url: adminit_permission_path(id: permission.id), scope: "permission", data: {turbo: true, controller: "autosubmit"}, method: :put) do |f| %>
      <%= render Core::LoaderComponent.new do %>
        <%= f.multi_select :role_ids, options_for_select(roles.map { |r| [r.name, r.id] }, permission.role_ids), {include_blank: false, include_hidden: false, required: true}, {class: "h-10 group-[.is-loading]:hidden", multiple: true, "data-controller": "core--form--select-component", "data-core--form--select-component-submit-value": "true", "data-core--form--select-component-allow-empty-value": "false", "data-action": "core--form--select-component:loaded->core--loader-component#loaded"} %>
      <% end %>

      <% available_widgets = Dashboard::WidgetRegistry.for_resource(permission.resource) %>
      <% if available_widgets.any? %>
        <div class="mt-3 border-t border-gray-200 dark:border-gray-700 pt-2">
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2"><%= I18n.t("adminit.permissions.widgets_label") %></p>
          <div class="space-y-2">
            <% roles.each do |role| %>
              <% role_widgets = PermissionRole.find_by(permission_id: permission.id, role_id: role.id)&.dashboard_widget_keys || [] %>
              <div class="flex flex-wrap gap-2 items-center">
                <span class="text-xs text-gray-600 dark:text-gray-300 w-24 truncate"><%= role.name %></span>
                <% available_widgets.each do |widget| %>
                  <label class="inline-flex items-center text-xs">
                    <%= check_box_tag "permission[dashboard_widget_keys][#{role.id}][]", widget.key.to_s, role_widgets.include?(widget.key.to_s), id: "permission_#{permission.id}_role_#{role.id}_widget_#{widget.key}", class: "rounded border-gray-300 text-primary-600 focus:ring-primary-500", data: {action: "change->autosubmit#submit"} %>
                    <span class="ml-1"><%= I18n.t("adminit.dashboard.kinds.#{widget.kind}") %></span>
                  </label>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</tr>
