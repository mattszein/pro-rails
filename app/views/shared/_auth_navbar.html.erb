<div class="flex pt-4 pr-4 justify-end">
  <div class="mr-2">
    <%= render Core::LocaleSwitcherComponent.new %>
  </div>
  <%= turbo_frame_tag :main_notifications, src: user_notifications_path, loading: :lazy, data: {turbo_permanent: true} do %>
    <div class="relative p-2.5 rounded-full transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-200 hover:outline-none hover:ring-2 hover:ring-primary-200 text-primary-400" aria-label="Notifications" aria-expanded="false">
      <%= icon("bell", classes: "w-7 h-7 animate-pulse") %>
      <span class="absolute top-0 right-0 flex h-6 w-6">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-50"></span>
      </span>
    </div>
  <% end %>
</div>
