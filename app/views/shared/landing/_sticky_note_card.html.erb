<div class="p-5 rounded-lg bg-slate-50 dark:bg-[#141416] border border-slate-100 dark:border-[#1f1f22] hover:bg-slate-100 dark:hover:bg-[#1a1a1c] transition-colors duration-300">
  <div class="flex items-center mb-3 space-x-2 text-slate-400 dark:text-slate-500">
    <%= icon(icon_name, classes: "w-[18px] h-[18px] shrink-0") %>
    <h4 class="font-medium text-slate-800 dark:text-slate-200 text-sm"><%= title %></h4>
  </div>
  <p class="text-slate-500 dark:text-slate-500 text-sm leading-relaxed"><%= description %></p>
</div>
