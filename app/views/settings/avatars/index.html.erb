<%= render Settings::LayoutComponent.new(active_section: :profile) do %>
  <% if @in_progress_avatars.any? %>
    <%# Auto-refresh every 8 s when any avatar is still generating so the list updates without a manual reload %>
    <div data-controller="auto-refresh"
         data-auto-refresh-interval-value="<%= @in_progress_avatars.any?(&:generating?) ? 8000 : 0 %>">
      <%= render Core::CardComponent.new(classes: "space-y-4 mb-4") do %>
        <div>
          <h2 class="font-semibold"><%= t("avatars.in_progress.title") %></h2>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("avatars.in_progress.subtitle") %></p>
        </div>

        <div class="space-y-2">
          <% @in_progress_avatars.each do |avatar| %>
            <div class="flex items-center justify-between p-3 rounded-xl border border-gray-200 dark:border-gray-700">
              <div class="flex items-center gap-3">
                <% if avatar.generating? %>
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
                    <%= t("avatars.in_progress.status.generating") %>
                  </span>
                <% elsif avatar.failed? %>
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300">
                    <%= t("avatars.in_progress.status.failed") %>
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300">
                    <%= t("avatars.in_progress.status.draft") %>
                  </span>
                <% end %>

                <span class="text-sm text-gray-600 dark:text-gray-400">
                  <% method_val = avatar.read_attribute(:method) %>
                  <% path_name = method_val == 0 ? t("avatars.in_progress.path.guided") : t("avatars.in_progress.path.freeform") %>
                  <%= t("avatars.in_progress.path_label", path: path_name, date: l(avatar.created_at, format: :short)) %>
                </span>
              </div>

              <div class="flex items-center gap-2">
                <% if avatar.generating? %>
                  <%= render(Core::LinkComponent.new(name: t("avatars.in_progress.action.view"), url: settings_avatar_path(avatar), style: :link)) %>
                <% elsif avatar.failed? %>
                  <%= render(Core::LinkComponent.new(name: t("avatars.in_progress.action.retry"), url: settings_avatar_path(avatar), style: :as_button, theme: :secondary, size: :sm)) %>
                <% elsif avatar.draft? && avatar.generated? %>
                  <%= render(Core::LinkComponent.new(name: t("avatars.in_progress.action.continue"), url: settings_avatar_path(avatar), style: :as_button, theme: :primary, size: :sm)) %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render Core::CardComponent.new(classes: "space-y-4") do %>
    <div class="flex items-center justify-between">
      <div>
        <h1><%= t("avatars.gallery.title") %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= t("avatars.gallery.subtitle") %></p>
      </div>
      <%= render(Core::LinkComponent.new(name: t("avatars.gallery.new_avatar"), url: new_settings_avatar_path, style: :as_button, theme: :primary)) %>
    </div>

    <% if @avatars.empty? %>
      <div class="text-center py-12 text-gray-400 dark:text-gray-500">
        <p><%= t("avatars.gallery.empty") %></p>
        <%= render(Core::LinkComponent.new(name: t("avatars.gallery.create_first"), url: new_settings_avatar_path, style: :link)) %>
      </div>
    <% else %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4"
           data-controller="avatar-gallery">
        <% @avatars.each do |avatar| %>
          <%= render partial: "settings/avatars/gallery_item", locals: { avatar: avatar } %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
