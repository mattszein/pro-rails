# .env — one per worktree.
# Copy this file to .env for a plain checkout (no worktree tooling). The two
# lines below are NOT optional in that case: COMPOSE_PROFILES is the only way
# to make the embedded db/redis services materialize, and without it DB_HOST
# defaults to `db` and nothing answers.

COMPOSE_PROFILES=infra
COMPOSE_FILE=docker-compose.yml:docker-compose.expose.yml

# --- Identity ------------------------------------------------
# COMPOSE_PROJECT_NAME=pro-rails-feat-new-profile
# APP_HOST=localhost

# --- Embedded infra (default) --------------------------------
# Nothing to set: DB_HOST=db, DB_PORT=5432, postgres/postgres, REDIS_DB=1.
# Volumes are project-prefixed, so each worktree gets its own PGDATA.
#
# Pin a Postgres major only if this feature needs one. PG_VERSION also feeds
# the PG_MAJOR build arg so the client libs in the app image match the server.
# PG_VERSION=15
# PG_IMAGE=postgres:15-alpine

# --- External infra ------------------------------------------
# Bare-metal servers, or a shared docker-compose.infra.yml stack.
# COMPOSE_PROFILES=          # must be empty: don't start local db/redis
# DB_HOST=host.docker.internal
# DB_PORT=5432
# DB_USERNAME=feat_new_profile
# DB_PASSWORD=secret
# DB_NAME_PREFIX=pro_rails_feat_new_profile
# REDIS_HOST=host.docker.internal
# REDIS_PORT=6379
# REDIS_DB=1
# ANYCABLE_REDIS_CHANNEL=pro-rails-feat-new-profile

# --- Routing -------------------------------------------------
# Traefik (no host ports; hostnames must resolve to the Traefik host):
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# APP_HOST=pro-rails-feat-new-profile.homelab
# WS_HOST=pro-rails-feat-new-profile-ws.homelab
# MAILDEV_HOST=pro-rails-feat-new-profile-mail.homelab
# ANYCABLE_WEBSOCKET_URL=ws://pro-rails-feat-new-profile-ws.homelab/cable
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=web
#
# Published ports: with docker-compose.expose.yml every port defaults to
# ephemeral on 127.0.0.1. Pin one only when you want a stable URL.
# RAILS_PORT=3000
# DB_HOST_PORT=5433

# --- API keys ------------------------------------------------
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# DASHSCOPE_API_KEY=
