# .env.traefik — template for feature worktrees (create-feature.sh).
#
#   cp .env.traefik.example .env.traefik    # gitignored: put the secrets there
#
# create-feature.sh copies .env.traefik into each new worktree as .env,
# replacing the placeholders. It always sets COMPOSE_PROJECT_NAME={{NAME}}.
#   {{NAME}}       pro-rails-feat-a    {{NAME_SAFE}}  pro_rails_feat_a
#   {{PROJECT}}    pro-rails           {{FEATURE}}    feat-a
#   {{DOMAIN}}     APP_DOMAIN of the machine: localhost | homelab
#
# For a plain local checkout (no worktree) use .env.example instead.

# --- Compose ----------------------------------------------------------------
COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# db + redis run inside each feature, with their own volumes.
COMPOSE_PROFILES=infra

# Read by containers-start.sh only. Without it every service without a profile
# starts, including chrome/test_system/ws_test. Drop this line once those are
# moved to `profiles: [test]` in docker-compose.yml.
FEATURE_SERVICES=rails

APP_HOST={{NAME}}.{{DOMAIN}}
WS_HOST={{NAME}}-ws.{{DOMAIN}}
MAILDEV_HOST={{NAME}}-maildev.{{DOMAIN}}
ANYCABLE_WEBSOCKET_URL=ws://{{NAME}}-ws.{{DOMAIN}}/cable
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=web

# --- Per-feature isolation --------------------------------------------------
DB_NAME_PREFIX={{NAME_SAFE}}
ANYCABLE_REDIS_CHANNEL={{NAME}}

# Pin a Postgres major for one feature with:
#   create-feature.sh ... --env PG_VERSION=15,PG_IMAGE=postgres:15-alpine

# --- API keys ---------------------------------------------------------------
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
SUPPORT_AI_ENABLED=false
